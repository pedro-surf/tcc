// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  bio       String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  ratings  SessionRating[]

  followers Follower[] @relation("followers")
  following Follower[] @relation("following")

  likes     Like[]
  devices   Device[]
  spotAccesses   SpotAccess[]
  spotChecks   SpotCheck[]
  accesses  UserAccess[]
  forecasts  SpotForecast[]
  competitions SpotCompetition[]
  createdSpots Spot[] @relation("SpotCreatedBy")
}

model Follower {
  id           String @id @default(uuid())

  followerId   String
  followingId  String

  follower     User @relation("following", fields: [followerId], references: [id])
  following    User @relation("followers", fields: [followingId], references: [id])

  createdAt    DateTime @default(now())

  @@unique([followerId, followingId])
}

enum WaveType {
  BEACHIE
  LEFT_POINT
  RIGHT_POINT
  A_FRAME
  SLAB
}

enum BottomType {
  SAND
  ROCK
  REEF
}

enum Country {
  BRAZIL
  AUSTRALIA
  PORTUGAL
  CHILE
  PERU
}

enum MediaType {
  IMAGE
  VIDEO
}

model Location {
  id          String   @id @default(uuid())
  name        String
  country     Country
  lat         Float?
  lng         Float?

  spots       Spot[]
  forecasts   SpotForecast[]
  createdAt   DateTime @default(now())
}

model Spot {
  id            String   @id @default(uuid())
  name          String
  waveType      WaveType
  bottomType    BottomType
  country       Country
  locationId    String
  description   String?
  /// Private spot: visible to creator and their friends only
  secret        Boolean  @default(false)
  lat           Float
  lng           Float
  difficulty    String?
  /// Ideal wind direction in degrees (0 = N, clockwise)
  idealWindDir  Float?
  /// Ideal swell direction in degrees (0 = N, clockwise)
  idealSwellDir Float?
  /// How well the spot tolerates strong swell (1–5)
  strongSwellTolerance Int?
  /// How well the spot tolerates strong wind (1–5)
  strongWindTolerance  Int?
  /// AI weekly outlook combining forecast + spot characteristics
  weeklyGeneratedDescription String?
  /// When weeklyGeneratedDescription was last produced
  weeklyGeneratedAt DateTime?
  createdById   String?

  createdAt   DateTime @default(now())

  sessions       Session[]
  accesses       SpotAccess[]
  location       Location? @relation(fields: [locationId], references: [id])
  createdBy      User? @relation("SpotCreatedBy", fields: [createdById], references: [id])
  forecasts      SpotForecast[]
  checks         SpotCheck[]
  competitions   SpotCompetition[]
  data           SpotData[]
  media          SpotMedia[]
  weeklyDescriptions SpotWeeklyDescription[]
}

/// Historical AI weekly outlooks for a spot (Spot.weeklyGenerated* is the latest cache).
model SpotWeeklyDescription {
  id          String   @id @default(uuid())
  spotId      String
  description String
  generatedAt DateTime @default(now())
  /// Start of the week this outlook covers (UTC Monday 00:00)
  weekStart   DateTime
  /// Optional representative forecast used for that week (best ideal / newest)
  primaryForecastId String?

  spot            Spot         @relation(fields: [spotId], references: [id])
  primaryForecast SpotForecast? @relation(fields: [primaryForecastId], references: [id])

  @@index([spotId, generatedAt])
}

model SpotMedia {
  id        String    @id @default(uuid())
  spotId    String
  mediaUrl  String
  mediaType MediaType
  mimeType  String?
  createdAt DateTime  @default(now())

  spot Spot @relation(fields: [spotId], references: [id])
}

model Sensor {
  id          String   @id @default(uuid())
  type        String
  data        Json
  recordedAt  DateTime
  createdAt   DateTime @default(now())

  sessionSensors SessionSensor[]
}

model Like {
  id        String @id @default(uuid())
  userId    String
  sessionId String

  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  session   Session @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId])
}


model Sample {
  id        String   @id @default(uuid())
  timestamp Float
  ax        Float
  ay        Float
  az        Float
  gx        Float
  gy        Float
  gz        Float
  lat       Float?
  lon       Float?
  fix       Int?
  alt       Float?
  sat       Int?

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
}

model ManeuverEvent {
  id        String   @id @default(uuid())
  timestamp Float
  type      String
  score     Float

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
}

model Board {
  id        String   @id @default(uuid())
  name      String
  length    Float
  width     Float
  thickness Float
  volume    Float?
  createdAt DateTime @default(now())
  sessions  Session[]
}

model SpotAccess {
  id        String   @id @default(uuid())
  spotId    String
  userId    String
  accessType String
  createdAt DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
  user      User @relation(fields: [userId], references: [id])
}

model SpotCompetition {
  id          String   @id @default(uuid())
  spotId      String
  name        String
  description String?
  date        DateTime
  createdById String?
  createdAt   DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id])
}

model SpotForecast {
  id          String   @id @default(uuid())
  spotId      String?
  locationId  String?
  ideal       Boolean
  score       Float?
  userId      String
  swell       Float
  swellDir    Float
  wind        Float
  windDir     Float
  period      Float?
  energy      Float?
  temp        Float?
  gust        String?
  power       String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  spot        Spot? @relation(fields: [spotId], references: [id])
  user        User @relation(fields: [userId], references: [id])
  location    Location? @relation(fields: [locationId], references: [id])
  weeklyDescriptions SpotWeeklyDescription[]

  @@unique([spotId, userId, timestamp])
}

model SpotCheck {
  id          String   @id @default(uuid())
  spotId      String
  userId      String
  description String
  score       Float
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  media SpotCheckMedia[]
}

model SpotCheckMedia {
  id          String    @id @default(uuid())
  spotCheckId String
  mediaUrl    String
  mediaType   MediaType
  mimeType    String?
  createdAt   DateTime  @default(now())

  spotCheck SpotCheck @relation(fields: [spotCheckId], references: [id])
}

model SessionSensor {
  id        String   @id @default(uuid())
  sessionId String
  sensorId  String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
  sensor    Sensor  @relation(fields: [sensorId], references: [id])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  spotId      String
  boardId     String?
  wetsuitId   String?
  date        DateTime
  durationMin Int
  waveCount   Int?
  maxWave     Float?
  avgWave     Float?
  notes       String?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  spot        Spot @relation(fields: [spotId], references: [id])
  board       Board? @relation(fields: [boardId], references: [id])
  wetsuit     Wetsuit? @relation(fields: [wetsuitId], references: [id])

  sessionSensors SessionSensor[]
  likes       Like[]
  sessionMedia SessionMedia[]
  sessionRatings SessionRating[]
  samples     Sample[]
  manuevers   ManeuverEvent[]
}

model SessionMedia {
  id        String   @id @default(uuid())
  sessionId String
  mediaUrl  String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
}

model SessionRating {
  id        String   @id @default(uuid())
  sessionId String
  rating    Int
  comments  String?
  creatorId String
  surfed    Boolean
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
  creator   User @relation(fields: [creatorId], references: [id])
}

model SpotData {
  id        String   @id @default(uuid())
  spotId    String
  data      Json
  createdAt DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
}

model Wetsuit {
  id        String   @id @default(uuid())
  name      String
  thickness Float
  createdAt DateTime @default(now())
  sessions  Session[]
}

model UserAccess {
  id        String   @id @default(uuid())
  userId    String
  accessType String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
}

model VisitorAccess {
  id        String   @id @default(uuid())
  visitorId String
  accessType String
  createdAt DateTime @default(now())
}

model Device {
  id        String   @id @default(uuid())
  type      String
  createdBy    String?
  createdAt DateTime @default(now())

  creator      User? @relation(fields: [createdBy], references: [id])
}