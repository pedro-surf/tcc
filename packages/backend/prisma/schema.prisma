// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  bio       String?
  avatarUrl String?
  /// Free-text home / surf base location
  location  String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  ratings  SessionRating[]

  followers Follower[] @relation("followers")
  following Follower[] @relation("following")

  likes     Like[]
  devices   Device[]
  spotAccesses   SpotAccess[]
  spotChecks   SpotCheck[]
  accesses  UserAccess[]
  forecasts  SpotForecast[]
  forecastFetches SpotForecastFetch[]
  competitions SpotCompetition[]
  heatEntries HeatSurfer[]
  createdSpots Spot[] @relation("SpotCreatedBy")
  gearOwnerships UserGear[] @relation("UserGearOwner")
  gearTransfersFrom UserGear[] @relation("UserGearFrom")
  offers    Offer[] @relation("OfferSeller")
  purchases Offer[] @relation("OfferBuyer")
}

model Follower {
  id           String @id @default(uuid())

  followerId   String
  followingId  String

  follower     User @relation("following", fields: [followerId], references: [id])
  following    User @relation("followers", fields: [followingId], references: [id])

  createdAt    DateTime @default(now())

  @@unique([followerId, followingId])
}

enum WaveType {
  BEACHIE
  LEFT_POINT
  RIGHT_POINT
  A_FRAME
  SLAB
}

enum BottomType {
  SAND
  ROCK
  REEF
}

enum Country {
  BRAZIL
  AUSTRALIA
  PORTUGAL
  CHILE
  PERU
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MarketplaceProductType {
  BOARD
  WETSUIT
  FINS
  LEASH
}

enum Currency {
  BRL
  USD
  EUR
}

enum ForecastSource {
  COPERNICUS_MARINE
  WORLD_WEATHER_ONLINE
  OPEN_METEO_MARINE
}

enum ForecastFetchKind {
  FORECAST
  HISTORY
}

model Location {
  id          String   @id @default(uuid())
  name        String
  country     Country
  lat         Float?
  lng         Float?

  spots       Spot[]
  forecasts   SpotForecast[]
  createdAt   DateTime @default(now())
}

model Spot {
  id            String   @id @default(uuid())
  name          String
  waveType      WaveType
  bottomType    BottomType
  country       Country
  locationId    String
  description   String?
  /// Private spot: visible to creator and their friends only
  secret        Boolean  @default(false)
  lat           Float
  lng           Float
  difficulty    String?
  /// Ideal wind direction in degrees (0 = N, clockwise)
  idealWindDir  Float?
  /// Ideal swell direction in degrees (0 = N, clockwise)
  idealSwellDir Float?
  /// How well the spot tolerates strong swell (1–5)
  strongSwellTolerance Int?
  /// How well the spot tolerates strong wind (1–5)
  strongWindTolerance  Int?
  /// AI weekly outlook combining forecast + spot characteristics
  weeklyGeneratedDescription String?
  /// When weeklyGeneratedDescription was last produced
  weeklyGeneratedAt DateTime?
  createdById   String?

  createdAt   DateTime @default(now())

  sessions       Session[]
  accesses       SpotAccess[]
  location       Location? @relation(fields: [locationId], references: [id])
  createdBy      User? @relation("SpotCreatedBy", fields: [createdById], references: [id])
  forecasts      SpotForecast[]
  forecastFetches SpotForecastFetch[]
  checks         SpotCheck[]
  competitions   SpotCompetition[]
  data           SpotData[]
  media          SpotMedia[]
  weeklyDescriptions SpotWeeklyDescription[]
}

/// Raw monthly payload from an external marine API (Copernicus, WWO, …).
/// One row per spot + source + month; used to fill the spot's past calendar
/// without re-hitting the provider.
model SpotForecastFetch {
  id            String            @id @default(uuid())
  spotId        String
  source        ForecastSource
  kind          ForecastFetchKind
  year          Int
  month         Int
  from          DateTime
  to            DateTime
  lat           Float
  lng           Float
  datasetId     String?
  rawPayload    Json
  requestedById String?
  fetchedAt     DateTime          @default(now())
  createdAt     DateTime          @default(now())

  spot        Spot  @relation(fields: [spotId], references: [id])
  requestedBy User? @relation(fields: [requestedById], references: [id])
  forecasts   SpotForecast[]

  @@unique([spotId, source, year, month, kind])
  @@index([spotId, year, month])
}

/// Historical AI weekly outlooks for a spot (Spot.weeklyGenerated* is the latest cache).
model SpotWeeklyDescription {
  id          String   @id @default(uuid())
  spotId      String
  description String
  generatedAt DateTime @default(now())
  /// Start of the week this outlook covers (UTC Monday 00:00)
  weekStart   DateTime
  /// Optional representative forecast used for that week (best ideal / newest)
  primaryForecastId String?

  spot            Spot         @relation(fields: [spotId], references: [id])
  primaryForecast SpotForecast? @relation(fields: [primaryForecastId], references: [id])

  @@index([spotId, generatedAt])
}

model SpotMedia {
  id        String    @id @default(uuid())
  spotId    String
  mediaUrl  String
  mediaType MediaType
  mimeType  String?
  createdAt DateTime  @default(now())

  spot Spot @relation(fields: [spotId], references: [id])
}

model Sensor {
  id          String   @id @default(uuid())
  type        String
  data        Json
  recordedAt  DateTime
  createdAt   DateTime @default(now())

  sessionSensors SessionSensor[]
}

model Like {
  id        String @id @default(uuid())
  userId    String
  sessionId String

  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  session   Session @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId])
}


model Sample {
  id        String   @id @default(uuid())
  timestamp Float
  ax        Float
  ay        Float
  az        Float
  gx        Float
  gy        Float
  gz        Float
  lat       Float?
  lon       Float?
  fix       Int?
  alt       Float?
  sat       Int?

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
}

model ManeuverEvent {
  id        String   @id @default(uuid())
  timestamp Float
  type      String
  score     Float

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  boards   Board[]
  wetsuits Wetsuit[]
  fins     Fins[]
  leashes  Leash[]
}

model Board {
  id        String   @id @default(uuid())
  name      String
  brandId   String?
  length    Float
  width     Float
  thickness Float
  volume    Float?
  createdAt DateTime @default(now())

  brand    Brand? @relation(fields: [brandId], references: [id])
  sessions Session[]
}

model Fins {
  id        String   @id @default(uuid())
  name      String
  brandId   String?
  size      String?
  createdAt DateTime @default(now())

  brand Brand? @relation(fields: [brandId], references: [id])
}

model Leash {
  id        String   @id @default(uuid())
  name      String
  brandId   String?
  length    Float?
  thickness Float?
  createdAt DateTime @default(now())

  brand Brand? @relation(fields: [brandId], references: [id])
}

/// Ownership / custody period for a piece of gear (trackable history).
model UserGear {
  id          String                 @id @default(uuid())
  userId      String
  productId   String
  productType MarketplaceProductType
  acquiredAt  DateTime               @default(now())
  /// Null while this user currently holds the gear
  releasedAt  DateTime?
  /// Previous owner when acquired via transfer
  fromUserId  String?
  /// Concluded offer that created this ownership record (if any)
  offerId     String?
  createdAt   DateTime               @default(now())

  user     User  @relation("UserGearOwner", fields: [userId], references: [id])
  fromUser User? @relation("UserGearFrom", fields: [fromUserId], references: [id])
  offer    Offer? @relation(fields: [offerId], references: [id])

  @@index([productType, productId, acquiredAt])
  @@index([userId, releasedAt])
}

model Offer {
  id          String                 @id @default(uuid())
  userId      String
  productId   String
  productType MarketplaceProductType
  price       Float
  currency    Currency               @default(BRL)
  title       String?
  description String?
  active      Boolean                @default(true)
  buyerId     String?
  concludedAt DateTime?
  createdAt   DateTime               @default(now())

  user          User       @relation("OfferSeller", fields: [userId], references: [id])
  buyer         User?      @relation("OfferBuyer", fields: [buyerId], references: [id])
  ownershipTransfers UserGear[]

  @@index([productType, active])
  @@index([userId, createdAt])
}

model SpotAccess {
  id        String   @id @default(uuid())
  spotId    String
  userId    String
  accessType String
  createdAt DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
  user      User @relation(fields: [userId], references: [id])
}

enum HeatStatus {
  PENDING
  RUNNING
  FINISHED
}

model SpotCompetition {
  id          String   @id @default(uuid())
  spotId      String
  name        String
  description String?
  date        DateTime
  createdById String?
  createdAt   DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id])
  heats     CompetitionHeat[]
}

model CompetitionHeat {
  id            String     @id @default(uuid())
  competitionId String
  name          String
  judgeCount    Int
  durationMin   Int
  status        HeatStatus @default(PENDING)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())

  competition SpotCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  surfers     HeatSurfer[]
  waves       HeatWave[]

  @@index([competitionId, createdAt])
}

model HeatSurfer {
  id        String   @id @default(uuid())
  heatId    String
  userId    String
  createdAt DateTime @default(now())

  heat  CompetitionHeat @relation(fields: [heatId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id])
  waves HeatWave[]

  @@unique([heatId, userId])
}

model HeatWave {
  id         String   @id @default(uuid())
  heatId     String
  surferId   String
  elapsedSec Int
  createdAt  DateTime @default(now())

  heat   CompetitionHeat @relation(fields: [heatId], references: [id], onDelete: Cascade)
  surfer HeatSurfer      @relation(fields: [surferId], references: [id], onDelete: Cascade)
  scores HeatWaveScore[]

  @@index([heatId, elapsedSec])
}

model HeatWaveScore {
  id         String   @id @default(uuid())
  waveId     String
  judgeIndex Int
  score      Float
  createdAt  DateTime @default(now())

  wave HeatWave @relation(fields: [waveId], references: [id], onDelete: Cascade)

  @@unique([waveId, judgeIndex])
}

model SpotForecast {
  id          String   @id @default(uuid())
  spotId      String?
  locationId  String?
  ideal       Boolean
  score       Float?
  userId      String
  swell       Float
  swellDir    Float
  wind        Float
  windDir     Float
  period      Float?
  energy      Float?
  temp        Float?
  gust        String?
  power       String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  source      ForecastSource?
  fetchId     String?

  spot        Spot? @relation(fields: [spotId], references: [id])
  user        User @relation(fields: [userId], references: [id])
  location    Location? @relation(fields: [locationId], references: [id])
  fetch       SpotForecastFetch? @relation(fields: [fetchId], references: [id])
  weeklyDescriptions SpotWeeklyDescription[]

  @@unique([spotId, userId, timestamp])
  @@index([spotId, timestamp])
}

model SpotCheck {
  id          String   @id @default(uuid())
  spotId      String
  userId      String
  description String
  score       Float
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  media SpotCheckMedia[]
}

model SpotCheckMedia {
  id          String    @id @default(uuid())
  spotCheckId String
  mediaUrl    String
  mediaType   MediaType
  mimeType    String?
  createdAt   DateTime  @default(now())

  spotCheck SpotCheck @relation(fields: [spotCheckId], references: [id])
}

model SessionSensor {
  id        String   @id @default(uuid())
  sessionId String
  sensorId  String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
  sensor    Sensor  @relation(fields: [sensorId], references: [id])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  spotId      String
  boardId     String?
  wetsuitId   String?
  date        DateTime
  durationMin Int
  waveCount   Int?
  maxWave     Float?
  avgWave     Float?
  notes       String?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  spot        Spot @relation(fields: [spotId], references: [id])
  board       Board? @relation(fields: [boardId], references: [id])
  wetsuit     Wetsuit? @relation(fields: [wetsuitId], references: [id])

  sessionSensors SessionSensor[]
  likes       Like[]
  sessionMedia SessionMedia[]
  sessionRatings SessionRating[]
  samples     Sample[]
  manuevers   ManeuverEvent[]
}

model SessionMedia {
  id        String   @id @default(uuid())
  sessionId String
  mediaUrl  String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
}

model SessionRating {
  id        String   @id @default(uuid())
  sessionId String
  rating    Int
  comments  String?
  creatorId String
  surfed    Boolean
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
  creator   User @relation(fields: [creatorId], references: [id])
}

model SpotData {
  id        String   @id @default(uuid())
  spotId    String
  data      Json
  createdAt DateTime @default(now())

  spot      Spot @relation(fields: [spotId], references: [id])
}

model Wetsuit {
  id        String   @id @default(uuid())
  name      String
  brandId   String?
  size      String?
  thickness Float
  createdAt DateTime @default(now())

  brand    Brand? @relation(fields: [brandId], references: [id])
  sessions Session[]
}

model UserAccess {
  id        String   @id @default(uuid())
  userId    String
  accessType String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
}

model VisitorAccess {
  id        String   @id @default(uuid())
  visitorId String
  accessType String
  createdAt DateTime @default(now())
}

model Device {
  id        String   @id @default(uuid())
  type      String
  createdBy    String?
  createdAt DateTime @default(now())

  creator      User? @relation(fields: [createdBy], references: [id])
}